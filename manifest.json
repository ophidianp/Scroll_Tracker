{
    "name": "Carnival Boilerplate",
    "description": "Scroll Tracker",
    "version": "0.1",
    "manifest_version": 3,
    "permissions": ["storage"],
    "action" :{
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "content_scripts" : [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ] 
}